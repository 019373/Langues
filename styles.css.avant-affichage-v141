:root{color-scheme:dark;--bg:#0d1523;--panel:#162235;--panel2:#1d2b40;--line:#2b3a50;--text:#f1f5fa;--muted:#a7b6ca;--en:#66b5ff;--it:#6fe0b7;--gold:#f2c875;--red:#ff9198;--radius:18px;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
*{box-sizing:border-box}html{min-height:100%;background:var(--bg)}body{margin:0;min-height:100vh;color:var(--text);background:radial-gradient(ellipse at top right,#1b2b44 0%,var(--bg) 58%);font-size:15px;-webkit-tap-highlight-color:transparent}button,input,textarea,select{font:inherit}button{cursor:pointer}button:disabled{opacity:.45;cursor:not-allowed}a{color:var(--en)}.loading{text-align:center;padding:80px 12px}.shell{width:min(680px,100%);margin:auto;padding:20px 17px calc(110px + env(safe-area-inset-bottom))}.top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:22px}.brand{display:flex;align-items:center;gap:11px}.mark{display:grid;place-items:center;width:43px;height:43px;border-radius:14px;background:linear-gradient(145deg,var(--en),var(--it));color:#0d1523;font-size:24px;font-weight:900}.brand-name{font-size:20px;font-weight:800;letter-spacing:-.6px}.small{font-size:12px;color:var(--muted)}.pill,.tag{border:1px solid var(--line);border-radius:999px;padding:6px 10px;font-size:12px;color:var(--muted);background:rgba(255,255,255,.025)}.pill.online{color:var(--it)}.pill.offline{color:var(--gold)}h1{font-size:27px;letter-spacing:-.75px;line-height:1.15;margin:0 0 8px}h2{font-size:18px;margin:0 0 12px;letter-spacing:-.2px}h3{font-size:15px;margin:0 0 8px}.sub{color:var(--muted);line-height:1.5;margin:0 0 19px}.card{border:1px solid var(--line);border-radius:var(--radius);background:var(--panel);padding:17px;margin-bottom:15px}.card.soft{background:var(--panel2)}.card.accent{background:linear-gradient(135deg,#1a3151,#172c35)}.row{display:flex;align-items:center;justify-content:space-between;gap:10px}.row.wrap{flex-wrap:wrap}.stack{display:grid;gap:10px}.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.metric{font-size:29px;font-weight:800;letter-spacing:-.8px;margin:4px 0}.caption{font-size:12px;color:var(--muted);line-height:1.45}.muted{color:var(--muted)}.en{color:var(--en)}.it{color:var(--it)}.gold{color:var(--gold)}.danger{color:var(--red)}.mt{margin-top:14px}.mb{margin-bottom:14px}.progress{height:8px;border-radius:999px;background:#314158;overflow:hidden;margin-top:9px}.progress>div{height:100%;border-radius:999px;background:linear-gradient(90deg,var(--en),var(--it));transition:width .25s}.btn{display:inline-flex;justify-content:center;align-items:center;gap:8px;border:1px solid var(--line);border-radius:12px;padding:12px 15px;background:#243751;color:var(--text);font-weight:700;text-decoration:none;min-height:45px}.btn.primary{background:linear-gradient(105deg,#66b5ff,#70d9bc);border:0;color:#102033}.btn.ghost{background:transparent}.btn.red{border-color:#70404a;color:var(--red);background:#311d29}.btn.full{width:100%}.btn.small{padding:8px 10px;min-height:34px;font-size:12px;border-radius:9px}.seg{display:flex;gap:5px;background:#111d2e;border:1px solid var(--line);padding:5px;border-radius:14px;margin-bottom:16px}.seg button{flex:1;border:0;border-radius:10px;background:none;color:var(--muted);font-size:13px;font-weight:650;padding:10px 4px}.seg button.active{background:#2d435e;color:var(--text)}.nav{position:fixed;z-index:20;bottom:0;left:0;right:0;display:flex;justify-content:center;background:rgba(15,23,37,.96);border-top:1px solid var(--line);padding:8px max(9px,env(safe-area-inset-left)) calc(8px + env(safe-area-inset-bottom)) max(9px,env(safe-area-inset-right));backdrop-filter:blur(18px)}.nav-inner{width:min(680px,100%);display:grid;grid-template-columns:repeat(4,1fr);gap:4px}.nav button{border:0;background:none;color:#9dafc6;display:grid;justify-items:center;gap:3px;padding:7px 1px;font-size:11px;border-radius:11px}.nav button.active{color:var(--en);background:#1c2d44}.nav .ni{font-size:22px;line-height:1.3}.study-front{display:grid;place-items:center;text-align:center;min-height:240px;border:1px solid #40556f;background:linear-gradient(145deg,#243959,#1c3047);padding:26px 17px;border-radius:20px;margin-bottom:15px}.study-front .prompt{font-size:clamp(21px,5.5vw,29px);font-weight:780;line-height:1.3;overflow-wrap:anywhere}.study-front .answer{font-size:clamp(19px,5vw,26px);font-weight:730;color:var(--it);line-height:1.3}.example{font-style:italic;color:var(--muted);font-size:14px;line-height:1.5}.rating{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.rating button{min-height:56px;padding:6px 2px;display:grid;place-items:center;gap:3px;font-size:12px}.rating .r0{border-color:#b15d66;color:#ffc4c5}.rating .r1{border-color:#9c774d;color:#ffe0a4}.rating .r2{border-color:#467cba;color:#cbe6ff}.rating .r3{border-color:#409278;color:#b8f8df}input,textarea,select{display:block;width:100%;background:#101b2c;border:1px solid #3a506c;color:var(--text);border-radius:12px;padding:13px;outline:none}input:focus,textarea:focus,select:focus{border-color:var(--en)}input::placeholder,textarea::placeholder{color:#8495ab}textarea{resize:vertical;min-height:70px}label{display:block;font-size:13px;color:var(--muted);margin-bottom:6px}.field{margin:0 0 12px}.list-card{padding:12px 0;border-bottom:1px solid var(--line);display:flex;gap:10px;justify-content:space-between;align-items:flex-start}.list-card:last-child{border-bottom:0}.list-card strong{display:block;font-size:14px}.list-card .caption{margin-top:4px}.badge{font-size:11px;border-radius:8px;padding:4px 7px;background:#263b55;color:var(--muted);white-space:nowrap}.bar{height:7px;background:#34465b;border-radius:10px;overflow:hidden;margin-top:6px}.bar>div{height:100%;background:var(--it)}.notice{font-size:13px;line-height:1.55;color:var(--muted);border-left:3px solid #5b91b9;padding:7px 11px;background:#17263a;border-radius:0 9px 9px 0;margin:12px 0}.notice.success{border-left-color:var(--it)}.notice.error{border-left-color:var(--red);color:#ffc3c8}.empty{text-align:center;padding:40px 14px;color:var(--muted)}.empty strong{display:block;color:var(--text);margin-bottom:9px}.thin{border:0;border-top:1px solid var(--line);margin:15px 0}.actions{display:flex;flex-wrap:wrap;gap:8px}.spaced{margin-bottom:20px}.spaced p{line-height:1.6;margin:7px 0 0}.tiny{font-size:11px;color:var(--muted)}code{background:#26384d;padding:2px 5px;border-radius:4px;font-size:12px}.file-input{display:none}button:focus-visible{outline:2px solid var(--en);outline-offset:3px}@media (max-width:390px){.shell{padding-left:12px;padding-right:12px}.card{padding:14px}.rating{gap:4px}.rating button{font-size:11px}.brand-name{font-size:18px}}

/* LexiCycle V1.3 */
.lc-icon{display:inline-block;vertical-align:middle;flex:none;pointer-events:none}
.mark{background:#27445f;color:#bfe3fa;border:1px solid #44698d}
.nav .ni{display:grid;place-items:center;height:25px}
.lc-lang{display:inline-flex;align-items:center;justify-content:center;min-width:23px;height:20px;padding:0 4px;border-radius:5px;font-size:10px;font-weight:750;margin-right:4px}
.lc-en{background:#274362;color:#b6dfff}
.lc-it{background:#20493f;color:#b5efd1}
.lc-empty{display:grid;place-items:center;width:52px;height:52px;margin:0 auto 14px;border-radius:50%;background:#224c44;color:#b4eed7}
.lc-work{border-color:#3d5e7c;background:linear-gradient(140deg,#1b3046,#15253a)}
.lc-work h2{display:flex;align-items:center;gap:8px;margin:0}
.lc-task-list{margin-top:12px}
.lc-task{display:flex;align-items:flex-start;gap:12px;padding:14px 0;border-top:1px solid var(--line)}
.lc-task-text{min-width:0;flex:1}
.lc-task-text strong{display:block;margin:6px 0 3px}
.lc-task-text p{font-size:13px;line-height:1.45;color:var(--muted)}
.lc-done{display:grid;place-items:center;flex:none;width:34px;height:34px;border:1px solid #6585a4;border-radius:10px;background:#223d54;color:#93adbf}
.lc-done:hover{color:#e4fff1;background:#245749}

/* LexiCycle V1.4 */
html,body{
 width:100%;
 max-width:100%;
 overflow-x:hidden;
 overscroll-behavior-x:none;
}
body{
 touch-action:pan-y;
}
html,body,.shell{
 scrollbar-width:none;
 -ms-overflow-style:none;
}
html::-webkit-scrollbar,
body::-webkit-scrollbar,
.shell::-webkit-scrollbar{
 display:none;
 width:0;
 height:0;
}
.shell,.card,.top,.row,.grid2,.study-front{
 max-width:100%;
 min-width:0;
}
input,textarea,select{
 max-width:100%;
}
